---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Thanks — we'll be in touch | Interlock Alert"
  description="Your enquiry has been received. A member of the Interlock Alert team will be in touch within one business day."
>
  <section class="hero hero--inner">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__grid hero__grid--narrow">
      <div class="hero__copy reveal text-center">
        <span class="eyebrow">Thanks</span>
        <h1 class="display">
          Got it. <span class="display__fade">We'll be in touch.</span>
        </h1>
        <p class="hero__sub">
          A member of the Interlock Alert team will reply within one business day with a tailored quote and your nearest installation window. If it's urgent, call us on <a href="tel:+443300000000">0330 000 0000</a>.
        </p>
        <div class="hero__cta">
          <a href="/" class="button button--primary">
            <span class="button__label">Back to home</span>
            <svg class="icon-18" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
