---
import Layout from '../../layouts/Layout.astro';
import FinalCTA from '../../components/FinalCTA.astro';
---
<Layout
  title="Fleet operators — alcohol interlock for HGV and haulage | Interlock Alert"
  description="Camera-verified, GPS-logged alcohol interlock devices for UK fleet operators — O-licence compliance, driver duty of care and audit-ready test logs at the ECU level."
>
  <section class="hero hero--inner">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy reveal">
        <span class="eyebrow">For fleet operators</span>
        <h1 class="display">
          Compliance on the dashboard. <span class="display__fade">Liability off the road.</span>
        </h1>
        <p class="hero__sub">
          For logistics, haulage and multi-drop operations carrying O-licence weight and driver duty of care. Interlock Alert puts a camera-verified, GPS-stamped pass on record before the engine ever starts — every shift, every driver, every vehicle.
        </p>
        <div class="hero__cta">
          <a href="/contact" class="button button--primary button--lg">
            <span class="button__label">Get a Free Quote</span>
            <svg class="icon-18" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </div>
      </div>

      <div class="hero__visual reveal reveal--delay-2">
        <figure class="hero__media">
          <img
            src="/images/fleet-operators.jpg"
            alt="Fleet of HGV trucks on a UK motorway"
            class="hero__media-img"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap wrap--narrow">
      <header class="section__header section__header--center reveal">
        <span class="section__eyebrow">The problem</span>
        <h2 class="section__heading">A spot check that wasn't done is the only one anyone remembers.</h2>
        <p class="section__lede">Manual breath checks miss most shifts. Paper logs lose the timestamp. And when an incident lands, it's the operator — not the driver — who has to evidence what was actually done that morning. Interlock Alert removes the gap entirely: every start is gated by a verified test, and every test is on record before the wheels turn.</p>
      </header>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="section__header reveal">
        <span class="section__eyebrow">What you get</span>
        <h2 class="section__heading">Built for the way fleets actually run.</h2>
      </header>

      <div class="feature-grid">
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-camera"/></svg></div>
          <h3 class="feature__title">Driver-ID on every test</h3>
          <p class="feature__body">A photo at the moment of sample stops drivers handing the unit to a sober colleague — the single biggest evasion risk on a manual policy.</p>
        </article>
        <article class="feature reveal reveal--delay-1">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-sliders"/></svg></div>
          <h3 class="feature__title">Per-vehicle BAC limits</h3>
          <p class="feature__body">Zero-tolerance on the HGV, road-legal threshold on the office pool car. Set per vehicle from the portal, change in a single tap.</p>
        </article>
        <article class="feature reveal reveal--delay-2">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-map-pin"/></svg></div>
          <h3 class="feature__title">GPS-stamped audit trail</h3>
          <p class="feature__body">Every test geo-pinned down to the street. The compliance file your TM, insurer and DVSA expect — generated automatically, not assembled after the fact.</p>
        </article>
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-bell"/></svg></div>
          <h3 class="feature__title">Live alerts on a fail</h3>
          <p class="feature__body">A failed test pushes to your nominated managers by SMS and email in seconds — not at the next yard visit.</p>
        </article>
        <article class="feature reveal reveal--delay-1">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-monitor"/></svg></div>
          <h3 class="feature__title">One portal, every depot</h3>
          <p class="feature__body">Add vehicles, assign drivers and pull signed compliance reports across every site, without raising a ticket.</p>
        </article>
        <article class="feature reveal reveal--delay-2">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-wrench"/></svg></div>
          <h3 class="feature__title">Override &amp; service mode</h3>
          <p class="feature__body">Authorised maintenance and yard moves without tripping a fail. Every override action is itself logged and attributed.</p>
        </article>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Built around your fleet, not the other way round."
    body="A few quick details — fleet size, drivetrains, depot locations — is all we need to come back with a tailored quote and an installation schedule that respects your shift pattern. No commitment, no obligation."
  />
</Layout>
