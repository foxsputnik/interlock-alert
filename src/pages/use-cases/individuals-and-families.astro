---
import Layout from '../../layouts/Layout.astro';
import FinalCTA from '../../components/FinalCTA.astro';
---
<Layout
  title="Individuals & families — alcohol interlock for personal vehicles | Interlock Alert"
  description="Alcohol interlock devices for UK private drivers and households — for newly qualified drivers, recovery, and families who want to know, for certain, the car won't move if they've been drinking."
>
  <section class="hero hero--inner">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy reveal">
        <span class="eyebrow">For individuals &amp; families</span>
        <h1 class="display">
          Some lines are <span class="display__fade">non-negotiable.</span>
        </h1>
        <p class="hero__sub">
          A newly qualified driver building good habits. Someone protecting their recovery. A household that needs to know — for certain — the car won't move if they've been drinking. Interlock Alert takes the decision off the road and out of the moment, every single time.
        </p>
        <div class="hero__cta">
          <a href="/contact" class="button button--primary button--lg">
            <span class="button__label">Get a Free Quote</span>
            <svg class="icon-18" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          </a>
        </div>
      </div>

      <div class="hero__visual reveal reveal--delay-2">
        <figure class="hero__media">
          <img
            src="/images/personal-car.jpg"
            alt="Individual driver beside a personal car on a residential street"
            class="hero__media-img"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--band">
    <div class="wrap wrap--narrow">
      <header class="section__header section__header--center reveal">
        <span class="section__eyebrow">Why people choose this</span>
        <h2 class="section__heading">Three honest reasons households fit an interlock.</h2>
      </header>

      <div class="feature-grid feature-grid--threes reveal">
        <article class="feature">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-users"/></svg></div>
          <h3 class="feature__title">A young driver, building good habits</h3>
          <p class="feature__body">For families putting a newly qualified driver behind the wheel — a hard, clear boundary that becomes second nature long before peer pressure ever tests it.</p>
        </article>
        <article class="feature">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-shield-check"/></svg></div>
          <h3 class="feature__title">Protecting a recovery</h3>
          <p class="feature__body">For someone committed to staying sober — a private, supportive layer of protection that removes the question entirely on the days it matters most.</p>
        </article>
        <article class="feature">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-lock"/></svg></div>
          <h3 class="feature__title">Certainty for the household</h3>
          <p class="feature__body">For families that want to know, without ambiguity, that the car will not move if anyone behind the wheel has had a drink. Quiet, confident, on every key turn.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="section__header reveal">
        <span class="section__eyebrow">How it works at home</span>
        <h2 class="section__heading">Discreet hardware, confidential data, professional fitting.</h2>
        <p class="section__lede">A private install at home or work, hardware that lives discreetly in the cabin, and data that stays inside your account. Interlock Alert was built for fleets, but the same engineering quietly raises the bar for everything fitted on a personal vehicle.</p>
      </header>

      <div class="feature-grid">
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-wrench"/></svg></div>
          <h3 class="feature__title">Mobile installation</h3>
          <p class="feature__body">Our certified engineers fit at your home or workplace in most postcodes — a single, scheduled appointment, usually within five working days.</p>
        </article>
        <article class="feature reveal reveal--delay-1">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-camera"/></svg></div>
          <h3 class="feature__title">Camera-verified test</h3>
          <p class="feature__body">A photo at the moment of sample means the result is always tied to the person who took it — not anyone else in the household.</p>
        </article>
        <article class="feature reveal reveal--delay-2">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-lock"/></svg></div>
          <h3 class="feature__title">Private by default</h3>
          <p class="feature__body">UK-hosted data, role-based access, no resale, no third-party tracking. Only the people you choose can see the test history.</p>
        </article>
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-bolt"/></svg></div>
          <h3 class="feature__title">All drivetrains supported</h3>
          <p class="feature__body">Petrol, diesel, hybrid and pure-electric — including modern keyless and CAN-bus vehicles. If it's road-legal in the UK, we install on it.</p>
        </article>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="A discreet decision, made once."
    body="Tell us a little about the vehicle and where you're based, and we'll come back with a tailored quote and a private installation appointment — usually within one business day."
  />
</Layout>
