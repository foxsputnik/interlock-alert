---
import Layout from '../layouts/Layout.astro';
import FinalCTA from '../components/FinalCTA.astro';
---
<Layout
  title="About Interlock Alert — UK-built alcohol interlock systems"
  description="Interlock Alert is a UK-built, UK-supported alcohol interlock platform — designed for the operators, tradespeople, fleet managers and families who can't afford to get drink driving wrong."
>
  <!-- HERO -->
  <section class="hero hero--inner">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="wrap hero__grid hero__grid--narrow">
      <div class="hero__copy reveal">
        <span class="eyebrow">About Interlock Alert</span>
        <h1 class="display">
          UK-built. Operator-tested. <span class="display__fade">Built around the people who carry the cost.</span>
        </h1>
        <p class="hero__sub">
          We make the only alcohol interlock in the UK that pairs camera-verified driver identity with always-on 4G connectivity — so every test is provable, and every result is in the hands of the people who answer for it within seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="section section--band">
    <div class="wrap wrap--narrow">
      <header class="section__header section__header--center reveal">
        <span class="section__eyebrow">Why we built this</span>
        <h2 class="section__heading">Drink driving is a decision made before the engine starts. We make sure that decision sticks.</h2>
        <p class="section__lede">Spot checks miss most of what they're meant to catch. Paper logs are gone the moment a contract turns into a court case. The operators, tradespeople, families and individuals who answer when something goes wrong deserve a system that puts the question of fitness to drive before the engine ever turns over — every shift, every driver, every time.</p>
      </header>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="section">
    <div class="wrap">
      <header class="section__header reveal">
        <span class="section__eyebrow">What we stand for</span>
        <h2 class="section__heading">A short list of things we won't compromise on.</h2>
      </header>

      <div class="feature-grid">
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-shield-check"/></svg></div>
          <h3 class="feature__title">Provable, every time</h3>
          <p class="feature__body">Every test is identity-verified at the moment of sample, GPS-stamped, and synced live. If a result ever needs to stand up to scrutiny, it does.</p>
        </article>
        <article class="feature reveal reveal--delay-1">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-gb"/></svg></div>
          <h3 class="feature__title">UK-built, UK-supported</h3>
          <p class="feature__body">Engineered, hosted and supported in the UK. Real engineers on the phone, in your region, six days a week — not a script and not an offshore queue.</p>
        </article>
        <article class="feature reveal reveal--delay-2">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-wrench"/></svg></div>
          <h3 class="feature__title">Dealer-grade fitting</h3>
          <p class="feature__body">Certified auto-electricians install at the ECU level — warranty-safe, MOT-safe, and discreet on every drivetrain on the UK road.</p>
        </article>
        <article class="feature reveal">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-monitor"/></svg></div>
          <h3 class="feature__title">A portal that respects your time</h3>
          <p class="feature__body">Add vehicles, assign drivers, set BAC limits, pull compliance reports — all without raising a ticket. The first interlock dashboard built to be used daily.</p>
        </article>
        <article class="feature reveal reveal--delay-1">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-lock"/></svg></div>
          <h3 class="feature__title">Your data, your control</h3>
          <p class="feature__body">UK-hosted, role-based access, no resale, no third-party tracking. The audit trail belongs to you and the people you choose to share it with.</p>
        </article>
        <article class="feature reveal reveal--delay-2">
          <div class="feature__icon"><svg class="icon-24" aria-hidden="true"><use href="#i-bolt"/></svg></div>
          <h3 class="feature__title">No lock-in</h3>
          <p class="feature__body">Transparent monthly pricing per device. No activation fees, no per-test charges, no multi-year contracts to escape from.</p>
        </article>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Talk to a real engineer."
    body="Tell us what you drive — single vehicle or full fleet — and we'll send a tailored quote and an installation window, usually within one business day."
  />
</Layout>
