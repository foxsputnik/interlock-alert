---
const year = new Date().getFullYear();
---
<footer class="footer" role="contentinfo">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a class="nav__brand" href="/" aria-label="Interlock Alert home">
        <img class="nav__brand-img" src="/images/interlock-alert-logp.png" alt="Interlock Alert" />
      </a>
      <p class="footer__tag">The UK's most advanced alcohol interlock system.</p>
    </div>
    <div>
      <div class="footer__h">Product</div>
      <a href="/#how-it-works">How it works</a>
      <a href="/#features">Features</a>
      <a href="/#portal">Portal</a>
      <a href="/#compatibility">Compatibility</a>
    </div>
    <div>
      <div class="footer__h">Use cases</div>
      <a href="/use-cases/fleet-operators">Fleet operators</a>
      <a href="/use-cases/trades-and-construction">Trades &amp; construction</a>
      <a href="/use-cases/company-vehicles">Company vehicles</a>
      <a href="/use-cases/individuals-and-families">Individuals &amp; families</a>
    </div>
    <div>
      <div class="footer__h">Company</div>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/#faq">FAQ</a>
    </div>
  </div>
  <div class="wrap footer__base">
    <span>© {year} Interlock Alert Ltd. Registered in England.</span>
    <span class="footer__legal">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/cookies">Cookies</a>
    </span>
  </div>
</footer>
