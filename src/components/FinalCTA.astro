---
interface Props {
  heading?: string;
  body?: string;
  useModal?: boolean;
}
const {
  heading = "Don't wait for the call you didn't want to take.",
  body = "Tell us what you drive and where you are. We'll send a tailored quote and installation window, usually within one business day.",
  useModal = false,
} = Astro.props;
---
<section class="final-cta" id="get-quote">
  <div class="wrap text-center reveal">
    <h2 class="final-cta__h">{heading}</h2>
    <p class="final-cta__p">{body}</p>
    {useModal ? (
      <button type="button" class="button button--primary button--xl final-cta__btn" data-quote-open>
        <span class="button__label">Get a Quote</span>
        <svg class="icon-20" aria-hidden="true"><use href="#i-arrow-right"/></svg>
      </button>
    ) : (
      <a href="/contact" class="button button--primary button--xl final-cta__btn">
        <span class="button__label">Get a Quote</span>
        <svg class="icon-20" aria-hidden="true"><use href="#i-arrow-right"/></svg>
      </a>
    )}
    <ul class="final-cta__bullets" role="list">
      <li>
        <svg class="icon-18" aria-hidden="true"><use href="#i-check"/></svg>
        <span>Tailored quote within 1 working day</span>
      </li>
      <li>
        <svg class="icon-18" aria-hidden="true"><use href="#i-check"/></svg>
        <span>UK-wide professional installation</span>
      </li>
      <li>
        <svg class="icon-18" aria-hidden="true"><use href="#i-check"/></svg>
        <span>Transparent monthly pricing — no activation fees</span>
      </li>
    </ul>
  </div>
</section>
