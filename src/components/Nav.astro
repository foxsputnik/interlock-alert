---
const { pathname } = Astro.url;
const isActive = (path: string) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path);
---
<div class="nav-utility" role="complementary" aria-label="Utility">
  <div class="wrap nav-utility__inner">
    <a href="tel:08000000000" class="nav-utility__item nav-utility__phone">
      <svg class="icon-14" aria-hidden="true"><use href="#i-phone"/></svg>
      <span>0800 000 0000</span>
    </a>
    <a href="#" class="nav-utility__item nav-utility__portal" aria-label="Client Portal (coming soon)">
      <svg class="icon-14" aria-hidden="true"><use href="#i-lock"/></svg>
      <span>Client Portal</span>
    </a>
  </div>
</div>
<header class="nav" role="banner">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="/" aria-label="Interlock Alert home">
      <img class="nav__brand-img" src="/images/interlock-alert-logp.png" alt="Interlock Alert" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="/the-device" class={`nav__link ${isActive('/the-device') ? 'nav__link--active' : ''}`}>The device</a>
      <a href="/what-is-an-alcohol-interlock" class={`nav__link ${isActive('/what-is-an-alcohol-interlock') ? 'nav__link--active' : ''}`}>What is an interlock?</a>
      <a href="/#use-cases" class={`nav__link ${isActive('/use-cases') ? 'nav__link--active' : ''}`}>Use cases</a>
      <a href="/faq" class={`nav__link ${isActive('/faq') ? 'nav__link--active' : ''}`}>FAQ</a>
      <a href="/about" class={`nav__link ${isActive('/about') ? 'nav__link--active' : ''}`}>About</a>
    </nav>

    <div class="nav__actions">
      <a href="/contact" class="button button--primary">
        <span class="button__label">Get a Free Quote</span>
        <svg class="icon-18" aria-hidden="true"><use href="#i-arrow-right"/></svg>
      </a>
    </div>
  </div>
</header>
