---
import IconSprite from '../components/IconSprite.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  bodyClass?: string;
}

const {
  title = "Interlock Alert — The UK's Most Advanced Alcohol Interlock System",
  description = "Prevent drink driving with Interlock Alert — GPS-logged, camera-verified alcohol interlock devices for UK fleets, trades, company vehicles and families. Get a quote today.",
  ogTitle = "Interlock Alert — The UK's Most Advanced Alcohol Interlock",
  ogDescription = "Breath-test, camera-verified, GPS-logged vehicle interlock. UK-wide professional installation.",
  bodyClass,
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=Inter+Tight:wght@500;600;700;800&display=swap" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/theme.js" defer></script>
</head>
<body class={bodyClass}>
  <IconSprite />
  <Nav />
  <main id="top">
    <slot />
  </main>
  <Footer />
</body>
</html>
